# ReuseHub Environment Configuration Example
SECRET_KEY=django-insecure-change-this-in-production-123456789
DEBUG=True

# Set to True to use SQLite locally instead of PostgreSQL
USE_SQLITE=False

# PostgreSQL Database Configuration
DB_NAME=ReuseHub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Centralized ReuseHub Mailing System (Resend HTTPS API over Port 443)
# ==============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Sender Address Configuration:
# - During testing without a verified custom domain, use Resend's testing address:
#   RESEND_FROM_EMAIL=ReuseHub <onboarding@resend.dev>
#   (NOTE: onboarding@resend.dev can only deliver to the email address registered with your Resend account)
# - For production delivery to any recipient, add and verify your custom domain in Resend
#   (e.g., mail.reusehub.org) and set:
#   RESEND_FROM_EMAIL=ReuseHub <support@yourdomain.com>
RESEND_FROM_EMAIL=ReuseHub <onboarding@resend.dev>

# ==============================================================================
# Cloudinary Storage (Media files for Render / Production)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Database Configuration (Render sets DATABASE_URL automatically)
# ==============================================================================
# DATABASE_URL=postgresql://user:password@host/database

# ==============================================================================
# Google OAuth 2.0 Credentials (Google Cloud Console)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

