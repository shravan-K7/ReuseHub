# ReuseHub Environment Configuration Example
SECRET_KEY=django-insecure-change-this-in-production-123456789
DEBUG=True

# Set to True to use SQLite locally instead of PostgreSQL
USE_SQLITE=False

# PostgreSQL Database Configuration
DB_NAME=ReuseHub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Centralized ReuseHub Mailing System Configuration
# ==============================================================================
# Central sender email account (e.g. reusehub.support@gmail.com)
# Setup instructions for Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character Google App Password under Security -> App Passwords
# 3. Enter your email and 16-character App Password below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=reusehub.support@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_google_app_password
DEFAULT_FROM_EMAIL=ReuseHub Support <reusehub.support@gmail.com>
