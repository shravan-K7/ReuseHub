# ReuseHub Environment Configuration Example
SECRET_KEY=django-insecure-change-this-in-production-123456789
DEBUG=True

# Set to True to use SQLite locally instead of PostgreSQL
USE_SQLITE=False

# PostgreSQL Database Configuration
DB_NAME=ReuseHub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Centralized ReuseHub Mailing System (Brevo HTTPS API over Port 443)
# ==============================================================================
# 1. BREVO_API_KEY:
#    Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# 2. BREVO_FROM_EMAIL:
#    Sender Address Configuration:
#    - Must match a verified sender in your Brevo account (Senders & IP -> Senders)
#    - Does NOT require a custom domain; personal/support Gmail addresses work once verified!
#    - Format: Name <email@example.com> or email@example.com
BREVO_FROM_EMAIL=ReuseHub Support <reusehub.support@gmail.com>

# ==============================================================================
# Cloudinary Storage (Media files for Render / Production)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Database Configuration (Render sets DATABASE_URL automatically)
# ==============================================================================
# DATABASE_URL=postgresql://user:password@host/database

# ==============================================================================
# Google OAuth 2.0 Credentials (Google Cloud Console)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

