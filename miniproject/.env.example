# ReuseHub Environment Configuration Example
SECRET_KEY=django-insecure-change-this-in-production-123456789
DEBUG=True

# Set to True to use SQLite locally instead of PostgreSQL
USE_SQLITE=False

# PostgreSQL Database Configuration
DB_NAME=ReuseHub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Centralized ReuseHub Mailing System Configuration
# ==============================================================================
# NOTE FOR RENDER USERS:
# Render's Free tier blocks outbound SMTP ports 25, 465, and 587.
# To send emails on Render Free tier, sign up at https://resend.com (free) and set:
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=ReuseHub <onboarding@resend.dev>
RESEND_API_KEY=
RESEND_FROM_EMAIL=ReuseHub <onboarding@resend.dev>

# Alternative HTTPS provider (Brevo / Sendinblue):
BREVO_API_KEY=
BREVO_SENDER_EMAIL=reusehub.support@gmail.com
BREVO_SENDER_NAME=ReuseHub Support

# Standard Gmail SMTP (Works locally or on Render Paid plans):
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character Google App Password under Security -> App Passwords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=reusehub.support@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_google_app_password
DEFAULT_FROM_EMAIL=ReuseHub Support <reusehub.support@gmail.com>

# ==============================================================================
# Cloudinary Storage (Media files for Render / Production)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Database Configuration (Render sets DATABASE_URL automatically)
# ==============================================================================
# DATABASE_URL=postgresql://user:password@host/database

# ==============================================================================
# Google OAuth 2.0 Credentials (Google Cloud Console)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

